# ── Perplexity API (obsługuje Claude Sonnet 4.6) ───────────
PERPLEXITY_API_KEY=pplx-...
# Model do użycia — domyślnie claude-sonnet-4-6
AI_MODEL=claude-sonnet-4-6

# ── Google (Gmail + Calendar) ───────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ── WhatsApp / Telegram ─────────────────────────────────────
# Podaj swój numer w formacie międzynarodowym (bez +), np. 48123456789
WHATSAPP_OWNER_NUMBER=48123456789

# Opcjonalnie: Telegram zamiast/obok WhatsApp
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# ── Aplikacja ───────────────────────────────────────────────
PORT=3000
APP_SECRET=zmien_mnie_na_losowy_ciag_znakow
TIMEZONE=Europe/Warsaw

# ── Zachowanie asystenta ────────────────────────────────────
ASSISTANT_NAME=Jarwis
OWNER_NAME=Mario
LANGUAGE=pl
